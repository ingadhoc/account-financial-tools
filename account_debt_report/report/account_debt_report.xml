<odoo>
    <record id="account_debt_report" model="ir.actions.report">
        <field name="name">Account Debt Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">account_debt_report.debt_xlsx</field>
        <field name="print_report_name">'Debt Report - %s' % object.commercial_partner_id.name</field>
    </record>

    <record id="account_debt_report_pdf" model="ir.actions.report">
        <field name="name">Account Debt Report (PDF)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_debt_report.report_debt</field>
        <field name="print_report_name">'Debt Report - %s' % object.commercial_partner_id.name</field>
    </record>
</odoo>
