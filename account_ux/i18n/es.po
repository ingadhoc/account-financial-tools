#. module: account_ux
#. odoo-python
#: code:addons/account_ux/models/res_company.py:0
msgid ""
"«%(company)s» and «%(parent)s» declare the same Tax ID (%(vat)s), so they "
"are the same legal entity and their «%(field)s» has to be the same. Either "
"change it on «%(parent)s», which applies it to the whole legal entity, or "
"give «%(company)s» its own Tax ID if it really is a different legal entity."
msgstr ""

#. module: account_ux
#. odoo-python
#: code:addons/account_ux/models/res_company.py:0
msgid ""
"«%(company)s» declares the Tax ID %(vat)s, which is already declared higher "
"up the tree by «%(ancestor)s», but the chain breaks at «%(parent)s». A Tax "
"ID cannot reappear below a break: «%(company)s» has to declare the same as «%"
"(parent)s» or something other than %(vat)s."
msgstr ""

