<?xml version="1.0"?>
<odoo>
    <record model="res.groups" id="group_restrict_change_currency_exchange">
        <field name="name">Restrict Change Invoice Currency Exchange</field>
    </record>

    <record id="group_reference_on_tree_and_main_form" model="res.groups">
        <field name="name">Show invoice reference field on tree and main form views</field>
    </record>

    <record id="account.journal_comp_rule" model="ir.rule">
        <field name="name">Journal multi-company</field>
        <field name="model_id" ref="model_account_journal"/>
        <!-- Same scope as account.journal._check_company_domain, see
             shared.to.branches.mixin. Two notes on why it is written like this:
             * ``legal_entity_root_id`` is read on the journal and not through
               ``company_id.legal_entity_root_id``: the dotted path would subquery
               res.company, where a branch user cannot read its own parent
               (res_company_rule_employee), and the journal would disappear.
             * the entity heads of the active companies are resolved through ``user``,
               the only record the rule evaluation context gives us. -->
        <field name="domain_force">
            [
                '|',
                ('company_id', 'in', company_ids),
                '&amp;',
                ('company_id', 'parent_of', company_ids),
                '|',
                ('shared_to_branches', '=', 'all'),
                '&amp;',
                ('shared_to_branches', '=', 'legal_entity'),
                ('legal_entity_root_id', 'in', user.company_id.browse(company_ids).legal_entity_root_id.ids)
            ]
        </field>
    </record>

    <!-- Global rules are combined with AND, so a permissive one is not enough: read moves
         to the rules below, and the native ones keep write/create/unlink as they were.
         A function and not a record: the native rules are noupdate, so a record would only
         apply on install and never reach databases where this module is updated. -->
    <function model="ir.rule" name="write">
        <value eval="[ref('account.account_move_comp_rule'), ref('account.account_move_line_comp_rule')]"/>
        <value eval="{'perm_read': False}"/>
    </function>

    <!-- Other branches' entries with receivable/payable lines, whole so the document opens. -->
    <record model="ir.rule" id="account_move_read_rule">
        <field name="name">Account Entry: read (branch debt aware)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), '&amp;', ('company_id', 'in', user._get_branch_debt_company_ids(company_ids)), ('line_ids.account_type', 'in', ['asset_receivable', 'liability_payable'])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record model="ir.rule" id="account_move_line_read_rule">
        <field name="name">Entry lines: read (branch debt aware)</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), '&amp;', ('company_id', 'in', user._get_branch_debt_company_ids(company_ids)), ('move_id.line_ids.account_type', 'in', ['asset_receivable', 'liability_payable'])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
