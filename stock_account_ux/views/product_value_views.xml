<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The native "Valuation Adjustments" menu is the only one: it is opened to the
         inventory users and its list and search are extended below. -->
    <record id="stock_account.valuation_adjustments_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.clear(), Command.link(ref('stock.group_stock_user'))]"/>
    </record>

    <record id="stock_account.product_value_list_action" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>

    <record id="product_value_list_view_entry_link" model="ir.ui.view">
        <field name="name">product.value.list.entry.link</field>
        <field name="model">product.value</field>
        <field name="inherit_id" ref="stock_account.product_value_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable"></attribute>
            </xpath>
            <field name="adjustment" position="after">
                <field name="account_move_id" string="Journal Entry" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="product_value_search_view_entry_link" model="ir.ui.view">
        <field name="name">product.value.search.entry.link</field>
        <field name="model">product.value</field>
        <field name="inherit_id" ref="stock_account.product_value_search_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="move_id"/>
                <field name="account_move_id" string="Journal Entry"/>
                <field name="description"/>
                <filter string="Not Booked" name="without_account_move"
                    domain="[('account_move_id', '=', False)]"
                    help="Value adjustments not booked yet: they are the ones making up the difference to adjust in the valuation report."/>
                <filter string="Booked" name="with_account_move"
                    domain="[('account_move_id', '!=', False)]"/>
                <separator/>
                <filter string="Price Change" name="price_change" domain="[('move_id', '=', False)]"/>
                <filter string="Move Adjustment" name="move_adjustment" domain="[('move_id', '!=', False)]"/>
            </field>
            <filter name="by_product" position="after">
                <filter string="Journal Entry" name="groupby_account_move" domain="[]" context="{'group_by': 'account_move_id'}"/>
                <filter string="Date" name="groupby_date" domain="[]" context="{'group_by': 'date'}"/>
            </filter>
        </field>
    </record>

    <record id="product_value_form_view_entry_link" model="ir.ui.view">
        <field name="name">product.value.form.entry.link</field>
        <field name="model">product.value</field>
        <field name="inherit_id" ref="stock_account.product_value_form_view"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="adjustment"
                    widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"
                    invisible="not id"
                    readonly="1"
                />
                <field name="account_move_id"
                    string="Journal Entry"
                    invisible="not account_move_id"
                    readonly="1"
                />
            </field>
        </field>
    </record>
    <record id="product_value_action_book" model="ir.actions.server">
        <field name="name">Book Value Adjustments</field>
        <field name="model_id" ref="stock_account.model_product_value"/>
        <field name="binding_model_id" ref="stock_account.model_product_value"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_value_product_values()
        </field>
    </record>
</odoo>
